<?xml version="1.0" encoding="ISO-8859-1"?>
<settings>
    <fbo_width>720</fbo_width>
    <fbo_height>540</fbo_height>
    <!-- Dead man's switch. If nothing arrives over the websocket for
         slide_timeout milliseconds, the player falls back to the .nap files in
         bin/data, picking a new one at random every slide_interval
         milliseconds, until a network drawing shows up again.
         Set slide_timeout to 0 to disable the fallback entirely. -->
    <slide_timeout>30000</slide_timeout>
    <slide_interval>10000</slide_interval>
    <!-- Image effect applied as the drawing goes to the screen: the name of a
         shader pair in bin/data/shaders, without the _gl3/_es3 suffix. A name
         that doesn't load leaves the drawing unprocessed. -->
    <shader_name>vhsc</shader_name>
    <!-- Volume, 0 to 1, of the drawing played out of the default sound card
         as XY oscilloscope audio (X left, Y right), to drive a real scope in
         X-Y mode. 0 mutes it and leaves the sound card closed, and the m key
         can't unmute it. -->
    <volume>0</volume>
    <!-- Low pass filter on the oscilloscope audio, which rounds corners and
         swallows small detail: cutoff in Hz (20 to 20000, 0 turns it off) and
         resonance (0.3 to 10, 0.707 is flat). -->
    <lowpass_cutoff>1500</lowpass_cutoff>
    <lowpass_resonance>0.707</lowpass_resonance>
    <!-- Channel delay, which delays X or Y to shear the drawing and open its
         lines into loops: in milliseconds, 0 to 20. Both at 0 turns it off.
         Like the low pass, it smears dense drawings, so lower values (or 0)
         keep them readable. -->
    <channel_delay_x>0</channel_delay_x>
    <channel_delay_y>0.6</channel_delay_y>
    <!-- Ring mod, which keeps the drawing moving once it's drawn by pulling
         its shapes in towards the center and letting them go again: depth
         (0 to 1, 0 turns it off) is how far, and freq (0.1 to 2000 Hz) how
         often. A freq that's a whole multiple of loop_hz holds still; anything
         else drifts, and the further from one, the faster. -->
    <ring_mod_freq>150.5</ring_mod_freq>
    <ring_mod_depth>0.1</ring_mod_depth>
    <!-- Two more ways to keep the drawing moving, both off (0) by default.
         noise_amount (0 to 0.5) jitters every line a little differently each
         time the beam comes round, as a fraction of half the screen, and
         noise_seed (0 to 1000) picks where its random numbers start; after
         that they carry on, so it only changes the first few moments.
         rotate_spin (-3600 to 3600 degrees per second) spins the whole
         drawing, anticlockwise, or clockwise when negative, starting from
         rotate_angle (-180 to 180 degrees, anticlockwise). Rotate is on when
         either one isn't 0. -->
    <noise_amount>0</noise_amount>
    <noise_seed>1</noise_seed>
    <rotate_spin>0</rotate_spin>
    <rotate_angle>0</rotate_angle>
    <!-- The rest of the effect chain, all off by default: the first setting
         of each turns it on, and 0 turns it off.
         High pass, the AC coupling of a cheap sound card, which makes shapes
         sag and smear: cutoff in Hz (1 to 2000) and resonance (0.3 to 10,
         0.707 is flat). -->
    <highpass_cutoff>0</highpass_cutoff>
    <highpass_resonance>0.707</highpass_resonance>
    <!-- Echo, which blends in ghost copies from earlier in the loop: mix (0 to
         1), time in milliseconds (0.1 to 1000) and feedback (0 to 0.95). -->
    <echo_mix>0</echo_mix>
    <echo_time>5</echo_time>
    <echo_feedback>0.5</echo_feedback>
    <!-- Drive, which pushes shapes out towards a rounded square: gain, 1 to
         20. -->
    <drive_gain>0</drive_gain>
    <!-- Wavefold, which folds the drawing back at the edges, a kaleidoscope:
         gain, 1 to 8. -->
    <wavefold_gain>0</wavefold_gain>
    <!-- Bit crush, which snaps the beam to a coarse grid: bits, 1 to 16, fewer
         for coarser. -->
    <bitcrush_bits>0</bitcrush_bits>
    <!-- Sample & hold, which lowers the sample rate into steps, corners and
         stray dots: rate in Hz, 50 to 48000. -->
    <sample_hold_rate>0</sample_hold_rate>
    <!-- The oscilloscope itself. loop_hz (1 to 100) is how many times a
         second the beam draws the whole picture: lower gives every shape more
         samples, and 1 keeps even dense drawings readable, while higher
         flickers less on a real scope. beam_size is the beam's radius in fbo
         pixels (0.5 to 12), and beam_intensity its brightness (0 to 4). These
         and the effect settings above can be tried out live on the panel (g),
         and override the same settings saved from it in effects.xml. -->
    <loop_hz>5</loop_hz>
    <beam_size>3</beam_size>
    <beam_intensity>1</beam_intensity>
    <debug_view>0</debug_view>
    <!-- Tezos chain read: poll TzKT for NAPLPS drawings stored on-chain.
         During slideshow mode, the player alternates between local files
         and chain drawings. Set tezos_contract to empty to disable. -->
    <tezos_contract>KT1DypSEV87pwiw6swdYqhDKWRBZ7xfqeS3c</tezos_contract>
    <tzkt_base>https://api.shadownet.tzkt.io/v1</tzkt_base>
    <tezos_poll_seconds>30</tezos_poll_seconds>
    <tezos_max_bytes>30000</tezos_max_bytes>
</settings>
